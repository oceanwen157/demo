{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": ["framework", "laravel"],
    "license": "MIT",
    "require": {
        "php": "^7.3|^8.0",
        "ext-curl": "*",
        "ext-json": "*",
        "deeplcom/deepl-php": "^1.11",
        "encore/laravel-admin": "^1.8",
        "fruitcake/laravel-cors": "^2.0",
        "godruoyi/php-snowflake": "^2.2",
        "gregwar/captcha": "^1.2",
        "guzzlehttp/guzzle": "^7.9",
        "infyomlabs/adminlte-templates": "8.0.x-dev",
        "infyomlabs/laravel-generator": "8.0.x-dev",
        "infyomlabs/swagger-generator": "2.0",
        "jaeger/querylist": "^4.2",
        "jenssegers/agent": "^2.6",
        "kakuilan/swaggervel": "^0.0.3",
        "laravel-admin-ext/config": "^1.1",
        "laravel-admin-ext/helpers": "1.*",
        "laravel-admin-ext/wang-editor": "1.*",
        "laravel-lang/lang": "^12.17",
        "laravel/framework": "^8.75",
        "laravel/sanctum": "^2.11",
        "laravel/tinker": "^2.5",
        "laravelcollective/html": "^6.2",
        "nyholm/psr7": "^1.8",
        "overtrue/pinyin": "^4.1",
        "predis/predis": "^2.3",
        "symfony/psr-http-message-bridge": "^2.3",
        "tymon/jwt-auth": "^1.0",
        "voku/anti-xss": "^4.1",
        "voku/portable-utf8": "^6.0"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^3.7",
        "barryvdh/laravel-ide-helper": "^2.14",
        "facade/ignition": "^2.5",
        "fakerphp/faker": "^1.9.1",
        "laravel/sail": "^1.0.1",
        "mockery/mockery": "^1.4.4",
        "nunomaduro/collision": "^5.10",
        "phpunit/phpunit": "^9.5.10"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/function.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
